# Point07 — variáveis de ambiente
# Copie para .env.local e preencha com os valores do `npm run db:start` (supabase start).
# NUNCA versionar .env.local.

# Fuso horário do servidor (Eventos/Painel Gerencial formatam data/hora e
# agrupam chamados por dia no fuso do processo Node): fixado em
# src/instrumentation.ts, não por variável de ambiente — a Vercel bloqueia
# `TZ` como nome reservado. Nada a configurar aqui.

# URL pública da plataforma. É a base dos QR codes das mesas (/mesa/<token>).
# Local: http://localhost:3000. Produção (Fase 6/7): o domínio próprio do cliente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL da API do Supabase local (porta dedicada do Point07 — ver supabase/config.toml)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55521

# Chave anônima (pública) impressa por `supabase start` / `supabase status`
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role (SECRETA — só no servidor). Impressa por `supabase status`.
# Usada apenas para criar usuários no Auth (painel de Usuários).
SUPABASE_SERVICE_ROLE_KEY=

# Push de notificação pro garçom (bônus não contratual — ver
# docs/Push-Notificacoes-Garcom-Bonus.md). Gerar uma vez com
# `npx web-push generate-vapid-keys` e nunca trocar depois (invalidaria as
# inscrições já salvas). NEXT_PUBLIC_VAPID_PUBLIC_KEY é a mesma chave pública,
# só que também exposta ao navegador (é pública por natureza, não é segredo).
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@point07.local
