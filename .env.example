# Point07 — variáveis de ambiente
# Copie para .env.local e preencha com os valores do `npm run db:start` (supabase start).
# NUNCA versionar .env.local.

# URL da API do Supabase local (porta dedicada do Point07 — ver supabase/config.toml)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55521

# Chave anônima (pública) impressa por `supabase start` / `supabase status`
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role (SECRETA — só no servidor). Impressa por `supabase status`.
# Usada apenas para criar usuários no Auth (painel de Usuários).
SUPABASE_SERVICE_ROLE_KEY=
